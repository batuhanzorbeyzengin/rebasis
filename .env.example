# rebasis — environment variable template
#
# This file is committed and shows variable NAMES ONLY.
# Real values go into .env.local, which is gitignored.
#
# ── the maintainer's GPU host ────────────────────────────────────────
# Nothing in this repository reads the four names below. They are consumed only
# by a local wrapper that is not part of a clone, and are listed here so that
# .env.local has one documented shape rather than two.
#
# REBASIS_REMOTE_HOST is an SSH ALIAS, not a hostname: the real hostname and key
# path live in ~/.ssh/config, entirely outside the repository, so an accidental
# commit leaks the string "rebasis-gpu" and nothing else. REBASIS_INSTANCE_ID
# exists because without an Elastic IP the public DNS changes on every
# stop/start and the wrapper re-resolves it.

REBASIS_REMOTE_HOST=
REBASIS_REMOTE_DIR=
REBASIS_INSTANCE_ID=
REBASIS_REGION=

# ── runtime, read by rebasis itself ──────────────────────────────────
# REBASIS_LOG_LEVEL=info
# REBASIS_LOG_LEVEL=info,rebasis.migrate=debug   # per-module tuning
# REBASIS_LOG_FORMAT=auto|console|json
# REBASIS_DETERMINISTIC=1
# REBASIS_MAX_MEMORY=2GB
# REBASIS_OTEL_ENABLED=1
